# .env.example — template konfigurasi. Salin ke .env dan isi nilai asli.
# JANGAN commit file .env yang berisi rahasia sebenarnya.

# App
NODE_ENV=development
# PORT: port utama. Bila terpakai, server memindai PORT_RANGE_START..END.
PORT=3001
PORT_RANGE_START=3001
PORT_RANGE_END=3010
API_PREFIX=api
API_VERSION=v1
# Origin yang diizinkan (REST + Socket.IO): admin (5173) & FE publik PoraAcehJaya (5174).
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:5174

# Database (PostgreSQL)
# DATABASE_URL: koneksi runtime. Produksi via PgBouncer (transaction mode):
#   tambahkan ?pgbouncer=true&connection_limit=1 (per instance serverless).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms_media?schema=public
# DIRECT_URL: koneksi LANGSUNG (non-pooled) utk `prisma migrate`/introspect.
# Dev: samakan dengan DATABASE_URL. Produksi: arahkan ke Postgres langsung (bukan pooler).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/cms_media?schema=public

# JWT
JWT_ACCESS_SECRET=ganti-dengan-secret-acak-panjang
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-lain
JWT_REFRESH_TTL=7d

# Cookie auth (httpOnly). Produksi (HTTPS): COOKIE_SECURE=true.
# Bila SPA beda subdomain, set COOKIE_DOMAIN (mis. .example.com); SameSite=none butuh Secure.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Media storage (local filesystem dulu; pindah ke S3 lewat StoragePort)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3001/uploads
MEDIA_MAX_SIZE_BYTES=10485760

# Integrasi simpora2026 (API publik; venue read-only & poll skor realtime)
SIMPORA_API_URL=http://localhost:8000/api
# Interval polling skor/leaderboard simpora2026 (ms)
SIMPORA_POLL_MS=4000

# Rate limit (auth & write-heavy)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Seeder (admin pertama) — ganti sebelum seed di lingkungan nyata
SEED_ADMIN_EMAIL=admin@cms-media.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_NAME=Administrator
