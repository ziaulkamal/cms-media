// prisma/schema.prisma
// Sumber kebenaran skema DB platform media berita (PostgreSQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url: koneksi runtime (boleh lewat pooler spt PgBouncer di produksi).
  url       = env("DATABASE_URL")
  // directUrl: koneksi langsung (non-pooled) khusus migrate/introspect.
  directUrl = env("DIRECT_URL")
}

/// Peran staf redaksi (RBAC). Default-deny: hak ditentukan per-peran.
enum UserRole {
  ADMIN
  EDITOR
  AUTHOR
  CONTRIBUTOR
}

/// Status alur editorial sebuah artikel.
enum ArticleStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

/// Status moderasi komentar pembaca.
enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

/// Jenis/sumber materi iklan.
enum AdCreativeKind {
  HOUSE_IMAGE // banner manual: gambar + link
  HOUSE_HTML  // embed HTML custom (hanya non-AMP)
  ADSENSE     // Google AdSense (client + slot)
}

/// Lingkungan render iklan: web biasa, AMP, atau keduanya.
enum AdPlatform {
  WEB
  AMP
  BOTH
}

/// Status operasional creative iklan.
enum AdCreativeStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

/// Tipe nilai setting (petunjuk render input di frontend).
enum SettingType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  JSON
  URL
}

/// Status publikasi halaman statis (lebih sederhana dari alur editorial artikel).
enum PageStatus {
  DRAFT
  PUBLISHED
}

/// Staf redaksi / pengguna internal sistem.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(CONTRIBUTOR)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  articles      Article[]
  uploadedMedia Media[]
  revisions     Revision[]
  comments      Comment[]

  @@index([role])
  @@map("users")
}

/// Rubrik berita; mendukung hierarki via self-relation parent/children.
model Category {
  id       String  @id @default(uuid()) @db.Uuid
  slug     String  @unique
  name     String
  parentId String? @map("parent_id") @db.Uuid

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  articles Article[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

/// Label many-to-many untuk artikel.
model Tag {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  name      String
  articles  ArticleTag[]
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("tags")
}

/// Konten berita inti + metadata editorial & SEO.
model Article {
  id              String        @id @default(uuid()) @db.Uuid
  slug            String        @unique
  title           String
  excerpt         String?
  body            Json
  status          ArticleStatus @default(DRAFT)
  authorId        String        @map("author_id") @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  featuredMediaId String?       @map("featured_media_id") @db.Uuid
  seoTitle        String?       @map("seo_title")
  seoDescription  String?       @map("seo_description")
  seoKeywords     String[]      @map("seo_keywords")
  viewCount       Int           @default(0) @map("view_count")
  publishedAt     DateTime?     @map("published_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Vektor full-text search; diisi otomatis oleh trigger (lihat migration FTS).
  tsv Unsupported("tsvector")?

  author        User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredMedia Media?       @relation("ArticleFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  tags          ArticleTag[]
  revisions     Revision[]
  comments      Comment[]

  // Indeks utama: daftar artikel published terbaru, filter rubrik, dan author.
  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId])
  @@index([authorId])
  @@index([tsv], type: Gin)
  @@map("articles")
}

/// Join table artikel <-> tag (PK komposit).
model ArticleTag {
  articleId String @map("article_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

/// Aset media; DB menyimpan metadata + storage key, file fisik di storage.
model Media {
  id           String   @id @default(uuid()) @db.Uuid
  storageKey   String   @map("storage_key")
  mimeType     String   @map("mime_type")
  size         Int
  width        Int?
  height       Int?
  title        String? // judul gambar (default: slug dari nama file)
  description  String? // deskripsi gambar (SEO)
  alt          String?
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy      User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  featuredInArticles Article[] @relation("ArticleFeaturedMedia")

  @@index([uploadedById])
  @@map("media")
}

/// Snapshot revisi artikel untuk audit & histori editorial.
model Revision {
  id        String   @id @default(uuid()) @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  editorId  String   @map("editor_id") @db.Uuid
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor  User    @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt(sort: Desc)])
  @@map("revisions")
}

/// Komentar pembaca dengan moderasi; mendukung balasan berjenjang & suka.
model Comment {
  id          String        @id @default(uuid()) @db.Uuid
  articleId   String        @map("article_id") @db.Uuid
  userId      String?       @map("user_id") @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  authorName  String?       @map("author_name")
  // Email pengomentar; INTERNAL — tidak pernah dikembalikan ke publik.
  authorEmail String?       @map("author_email")
  body        String
  status      CommentStatus @default(PENDING)
  likeCount   Int           @default(0) @map("like_count")
  createdAt   DateTime      @default(now()) @map("created_at")

  article Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([articleId, status])
  @@index([parentId])
  @@map("comments")
}

/// Posisi iklan bernama (mis. "home_top") + dimensi bidang yang di-reserve.
model AdSlot {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  name         String
  description  String?
  width        Int? // lebar bidang (px) yang di-reserve; penting utk AMP & anti-CLS
  height       Int? // tinggi bidang (px)
  isAmpEnabled Boolean  @default(false) @map("is_amp_enabled") // tampil di halaman AMP?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creatives AdCreative[]

  @@map("ad_slots")
}

/// Materi iklan; field wajib berbeda per kind (HOUSE_IMAGE/HOUSE_HTML/ADSENSE).
model AdCreative {
  id       String           @id @default(uuid()) @db.Uuid
  slotId   String           @map("slot_id") @db.Uuid
  kind     AdCreativeKind
  platform AdPlatform       @default(WEB)
  status   AdCreativeStatus @default(DRAFT)
  name     String

  // HOUSE_IMAGE
  imageUrl  String? @map("image_url")
  targetUrl String? @map("target_url")
  alt       String?

  // HOUSE_HTML
  htmlSnippet String? @map("html_snippet")

  // ADSENSE
  adClient String? @map("ad_client") // ca-pub-xxxxxxxxxxxxxxxx
  adSlot   String? @map("ad_slot") // id slot numerik
  adFormat String? @map("ad_format") // mis. "auto" (responsif) atau ukuran tetap

  // Dimensi override (kalau beda dari slot)
  width  Int?
  height Int?

  priority  Int       @default(0)
  startAt   DateTime? @map("start_at")
  endAt     DateTime? @map("end_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  slot AdSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  // Mendukung query serving: creative per slot, urut status & prioritas.
  @@index([slotId, status, priority])
  @@map("ad_creatives")
}

/// Konfigurasi situs dinamis (key-value); bisa ditambah tanpa migration.
model Setting {
  id        String      @id @default(uuid()) @db.Uuid
  key       String      @unique // mis. "site_title", "site_url"
  value     Json? // nilai fleksibel (string/number/boolean/object)
  type      SettingType @default(STRING)
  group     String      @default("general") // pengelompokan UI: general/seo/social...
  label     String? // label tampilan opsional
  isPublic  Boolean     @default(false) @map("is_public") // boleh dibaca publik (SEO/meta)?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

/// Halaman statis (mis. Tentang, Kebijakan Privasi, Syarat & Ketentuan).
/// Terpisah dari Article: tanpa kategori/tag/komentar/alur review.
model Page {
  id             String     @id @default(uuid()) @db.Uuid
  slug           String     @unique
  title          String
  body           Json
  status         PageStatus @default(DRAFT)
  seoTitle       String?    @map("seo_title")
  seoDescription String?    @map("seo_description")
  // Halaman wajib (TOC, Syarat & Ketentuan) tak boleh dihapus.
  isMandatory    Boolean    @default(false) @map("is_mandatory")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@map("pages")
}
